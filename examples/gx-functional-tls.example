# Gx functional test over TLS/TCP: single CCR-I/CCA-I, Diameter secured with TLS on both roles.

PEERS=(
    "pcrf-mock server gx --server-port 3868 --admin-port 8274 --origin-host pcrf.example.com --origin-realm example.com"
    "pgw-sim client gx --peer-host localhost --peer-port 3868 --admin-port 8174 --origin-host pgw.example.com --origin-realm example.com"
)

EXTRA_H2AGENT_ARGS=""
# TLS/TCP on the Diameter hop (HTTP/2 towards h2agent stays clear text). Applied
# globally; each flag only takes effect on the relevant role:
#   - --diameter-server-crt/key      -> server peer (pcrf-mock, diameter-port>0)
#   - --secure-diameter-client / --diameter-client-ca -> client peer (pgw-sim,
#                                       diameter-peer-host set)
# Certs (ca/server/client PEM) are generated by 1.deploy.sh when SSL=1 and
# mounted read-only at /ssl in every h2diagent container.
EXTRA_H2DIAGENT_ARGS="--diameter-server-crt /ssl/server.crt --diameter-server-key /ssl/server.key --secure-diameter-client --diameter-client-ca /ssl/ca.crt"
SSL=1
LOG_LEVEL="Warning"
PEERING_WAIT=4
TRIGGER="http://localhost:8174/admin/v1/client-provision/send-gx-ccr"
