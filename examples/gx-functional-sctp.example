# Gx functional test over SCTP single-homing: single CCR-I/CCA-I, SCTP on both roles.

PEERS=(
    "pcrf-mock server gx --server-port 3868 --admin-port 8274 --origin-host pcrf.example.com --origin-realm example.com"
    "pgw-sim client gx --peer-host localhost --peer-port 3868 --admin-port 8174 --origin-host pgw.example.com --origin-realm example.com"
)

EXTRA_H2AGENT_ARGS=""
# SCTP single-homing on both roles. --diameter-server-transport only takes
# effect on the server peer (diameter-port > 0); --diameter-client-transport
# only on the client peer (diameter-peer-host set). Applying both globally is
# therefore safe and yields SCTP for pcrf-mock (listener) and pgw-sim (dialer).
EXTRA_H2DIAGENT_ARGS="--diameter-server-transport sctp --diameter-client-transport sctp"
LOG_LEVEL="Warning"
PEERING_WAIT=4
TRIGGER="http://localhost:8174/admin/v1/client-provision/send-gx-ccr"
