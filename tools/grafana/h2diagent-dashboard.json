                    "mappings": [
                        { "options": { "0": { "text": "CLOSED" } }, "type": "value" },
                        { "options": { "1": { "text": "OPEN" } }, "type": "value" },
                        { "options": { "2": { "text": "PENDING" } }, "type": "value" }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 },
                            { "color": "yellow", "value": 2 }
